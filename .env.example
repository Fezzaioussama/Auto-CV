# ============================================================================
# Auto-CV environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values. `.env` is gitignored and
# never committed. All LLM calls go through src/llm_client.py, which reads the
# variables below.
# ============================================================================

# Which LLM provider to use for every call.
#   local      -> a self-hosted OpenAI-compatible server (vLLM / Ollama / etc.)
#   openrouter -> the OpenRouter serverless API (https://openrouter.ai)
SOURCE_LLM=local


# ---------------------------------------------------------------------------
# LOCAL provider (used when SOURCE_LLM=local)
# ---------------------------------------------------------------------------
# Base URL of your OpenAI-compatible server. Must include the API version path
# (e.g. ".../v1"). The client POSTs to `${LOCAL_LLM_URL}/chat/completions`.
LOCAL_LLM_URL=http://127.0.0.1:8002/v1
# Default model name served by that endpoint.
LOCAL_LLM_MODEL=Qwen/Qwen3-Coder-Next-FP8
# API key, only if your local server requires one (leave blank otherwise).
LOCAL_LLM_API_KEY=

# Optional: per-task model overrides for the local provider. If unset, each
# task uses LOCAL_LLM_MODEL above. Useful if your server hosts several models.
# LOCAL_MODEL_ANALYSIS=
# LOCAL_MODEL_SECTION_REWRITE=
# LOCAL_MODEL_PROPOSAL=
# LOCAL_MODEL_INTERVIEW=
# LOCAL_MODEL_SMART_CV=


# ---------------------------------------------------------------------------
# OPENROUTER provider (used when SOURCE_LLM=openrouter)
# ---------------------------------------------------------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Base URL (rarely needs changing).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers shown on the OpenRouter dashboard.
OPENROUTER_APP_NAME=Auto-CV
OPENROUTER_APP_URL=

# Global default model used for any task without a specific override below.
# Browse models + IDs at https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Per-task model overrides for OpenRouter. Route cheap calls to a small model
# and harder ones to a stronger model. Examples (uncomment and edit):
# OPENROUTER_MODEL_ANALYSIS=openai/gpt-4o-mini
# OPENROUTER_MODEL_SECTION_REWRITE=anthropic/claude-3.5-sonnet
# OPENROUTER_MODEL_PROPOSAL=anthropic/claude-3.5-sonnet
# OPENROUTER_MODEL_INTERVIEW=openai/gpt-4o
# OPENROUTER_MODEL_SMART_CV=anthropic/claude-3.5-sonnet
# Fixing broken LaTeX benefits from a strong model — set one here if you like:
# OPENROUTER_MODEL_LATEX_REPAIR=anthropic/claude-3.5-sonnet


# ---------------------------------------------------------------------------
# Shared tuning (apply to whichever provider is active)
# ---------------------------------------------------------------------------
# Connect timeout (seconds): fail fast if the host is unreachable.
LLM_CONNECT_TIMEOUT=10
# Read timeout (seconds): allow a slow model time to respond.
LLM_TIMEOUT=3600
# Max concurrent LLM requests for the parallel section rewriter.
LLM_MAX_WORKERS=5

# ---------------------------------------------------------------------------
# LaTeX rendering + auto-repair
# ---------------------------------------------------------------------------
# How many times the LLM may try to fix a non-compiling document before the
# render endpoint gives up (0 disables auto-repair).
LATEX_REPAIR_ATTEMPTS=2
# pdflatex wall-clock budget per compile attempt, in seconds.
LATEX_COMPILE_TIMEOUT=120
