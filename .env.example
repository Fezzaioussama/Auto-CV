# ============================================================================
# Auto-CV environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values. `.env` is gitignored and
# never committed. All LLM calls go through src/llm_client.py, which reads the
# variables below.
# ============================================================================

# Which LLM provider to use for every call.
#   local      -> a self-hosted OpenAI-compatible server (vLLM / Ollama / etc.)
#   openrouter -> the OpenRouter serverless API (https://openrouter.ai)
SOURCE_LLM=local


# ---------------------------------------------------------------------------
# LOCAL provider (used when SOURCE_LLM=local)
# ---------------------------------------------------------------------------
# Base URL of your OpenAI-compatible server. Must include the API version path
# (e.g. ".../v1"). The client POSTs to `${LOCAL_LLM_URL}/chat/completions`.
LOCAL_LLM_URL=http://195.154.75.46:8002/v1
# Default model name served by that endpoint.
LOCAL_LLM_MODEL=Qwen/Qwen3-Coder-Next-FP8
# API key, only if your local server requires one (leave blank otherwise).
LOCAL_LLM_API_KEY=

# Optional: per-task model overrides for the local provider. If unset, each
# task uses LOCAL_LLM_MODEL above. Useful if your server hosts several models.
# LOCAL_MODEL_ANALYSIS=
# LOCAL_MODEL_SECTION_REWRITE=
# LOCAL_MODEL_PROPOSAL=
# LOCAL_MODEL_INTERVIEW=
# LOCAL_MODEL_SMART_CV=
# Vision model for OCR fallback (only used if Tesseract isn't installed):
# LOCAL_MODEL_OCR=


# ---------------------------------------------------------------------------
# OPENROUTER provider (used when SOURCE_LLM=openrouter)
# ---------------------------------------------------------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Base URL (rarely needs changing).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers shown on the OpenRouter dashboard.
OPENROUTER_APP_NAME=Auto-CV
OPENROUTER_APP_URL=

# Global default model used for any task without a specific override below.
# Browse models + IDs at https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Per-task model overrides for OpenRouter. Route cheap calls to a small model
# and harder ones to a stronger model. Examples (uncomment and edit):
# OPENROUTER_MODEL_ANALYSIS=openai/gpt-4o-mini
# OPENROUTER_MODEL_SECTION_REWRITE=anthropic/claude-3.5-sonnet
# OPENROUTER_MODEL_PROPOSAL=anthropic/claude-3.5-sonnet
# OPENROUTER_MODEL_INTERVIEW=openai/gpt-4o
# OPENROUTER_MODEL_SMART_CV=anthropic/claude-3.5-sonnet
# Fixing broken LaTeX benefits from a strong model — set one here if you like:
# OPENROUTER_MODEL_LATEX_REPAIR=anthropic/claude-3.5-sonnet
# OCR fallback for image / scanned-PDF uploads when Tesseract isn't installed.
# MUST be a vision-capable model (the default text models cannot read images):
# OPENROUTER_MODEL_OCR=openai/gpt-4o-mini


# ---------------------------------------------------------------------------
# Shared tuning (apply to whichever provider is active)
# ---------------------------------------------------------------------------
# Connect timeout (seconds): fail fast if the host is unreachable.
LLM_CONNECT_TIMEOUT=10
# Read timeout (seconds): allow a slow model time to respond.
LLM_TIMEOUT=3600
# Max concurrent LLM requests for the parallel section rewriter.
LLM_MAX_WORKERS=5

# ---------------------------------------------------------------------------
# LaTeX rendering + auto-repair
# ---------------------------------------------------------------------------
# How many times the LLM may try to fix a non-compiling document before the
# render endpoint gives up (0 disables auto-repair).
LATEX_REPAIR_ATTEMPTS=2
# pdflatex wall-clock budget per compile attempt, in seconds.
LATEX_COMPILE_TIMEOUT=120
# External LaTeX→PDF compile service. REQUIRED on hosts without a TeX toolchain
# (e.g. Vercel serverless, which can't run pdflatex). Stand up the container in
# latex-service/ (see its README), then point these at it. Leave BLANK to use a
# locally installed pdflatex instead (the default for local development).
#   LATEX_COMPILE_URL=https://your-latex-service.onrender.com/compile
#   LATEX_COMPILE_TOKEN=<same COMPILE_TOKEN you set on the service>
LATEX_COMPILE_URL=
LATEX_COMPILE_TOKEN=

# ---------------------------------------------------------------------------
# OCR for image CVs and scanned (image-only) PDFs
# ---------------------------------------------------------------------------
# Layered: Tesseract (offline, free) is used when installed; otherwise the app
# falls back to the vision model above (OPENROUTER_MODEL_OCR / LOCAL_MODEL_OCR).
# Tesseract languages — each needs its data pack installed (tesseract-ocr-fra…).
OCR_LANGUAGES=eng
# Rasterization DPI for scanned PDFs (higher = sharper but slower/larger).
OCR_PDF_DPI=200
# Cap pages OCR'd per PDF (protects cost/latency on huge files).
OCR_MAX_PAGES=10
# Longest image edge (px) sent to the vision LLM — downscaled to limit tokens.
OCR_VISION_MAX_SIDE=2200

# ===========================================================================
# Web app: accounts, database, security  (public deployment)
# ===========================================================================
# development relaxes a few safety defaults (debug allowed, insecure cookies,
# ephemeral SECRET_KEY). Anything else (incl. unset) is treated as production.
FLASK_ENV=development
# Werkzeug debugger. MUST stay 0 in production (debug console = RCE if exposed).
FLASK_DEBUG=0

# REQUIRED in production. Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Database. Defaults to a local SQLite file under instance/. For production use
# Postgres, e.g. postgresql+psycopg://user:pass@host:5432/autocv
DATABASE_URL=

# Session cookies. Secure (HTTPS-only) defaults ON in production; set to 1 to
# force it on in development behind HTTPS, leave blank to follow FLASK_ENV.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_DAYS=14

# CSRF protection for browser requests (keep on for a public app).
WTF_CSRF_ENABLED=1

# Max upload / request body size in MB (PDF/DOCX CV uploads, JSON payloads).
MAX_CONTENT_LENGTH_MB=8

# Rate limiting. Storage memory:// is fine for one process; use redis://… when
# running multiple workers so limits are shared.
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per hour
RATELIMIT_LLM=40 per hour
RATELIMIT_AUTH=20 per hour
# Public, no-login demo endpoint (tight, per-IP — it runs an LLM call).
RATELIMIT_DEMO=5 per day

# Comma-separated allowed CORS origins for the JSON API. Leave blank for a
# same-origin app (recommended). Only set if a separate frontend calls the API.
CORS_ORIGINS=

# --- Reverse proxy ---------------------------------------------------------
# Number of proxies/load balancers in front of the app. Set to 1 (or more) in
# production so the real client IP and HTTPS scheme reach the app; 0 = direct.
PROXY_FIX_HOPS=0

# --- Transactional email (password reset + email verification) -------------
# If SMTP_HOST is blank, emails are NOT sent over the network — the link is
# logged to the console instead (fine for local dev). Set these to send real
# mail in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
MAIL_FROM=Auto-CV <no-reply@auto-cv.local>
# Absolute base URL used to build links in emails (e.g. https://app.example.com).
# Falls back to the incoming request URL when blank.
PUBLIC_BASE_URL=
# Require users to confirm their email before they can sign in (off by default).
REQUIRE_EMAIL_VERIFICATION=0
# Lifetime (seconds) of reset / verification links.
RESET_TOKEN_MAX_AGE_SECONDS=3600
VERIFY_TOKEN_MAX_AGE_SECONDS=86400

# --- Error tracking (optional) ---------------------------------------------
# Set a Sentry DSN to enable error reporting (needs: pip install sentry-sdk[flask]).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
