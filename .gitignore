# ─────────────────────────────────────────────
# Secrets / local configuration  (NEVER commit)
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/
.Python
pip-log.txt
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Instance folder (local SQLite DB, uploads) — never commit user data
instance/
*.db
*.sqlite3

# Testing / coverage / type-checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Notebooks
.ipynb_checkpoints/

# ─────────────────────────────────────────────
# Generated CV output  (keep the folder, drop the artifacts)
# ─────────────────────────────────────────────
output/*
!output/.gitkeep

# LaTeX build artifacts (anywhere)
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.out
*.log

# ─────────────────────────────────────────────
# AI / agent tooling working dirs  (local-only)
# ─────────────────────────────────────────────
.claude/
.claude/settings.local.json
.agents/
.codex/
plans/

# ─────────────────────────────────────────────
# Editor / OS
# ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Deployment metadata, local personal fixtures, and credential exports
.vercel/
node_modules/
test_example/
*.p12
*.pfx
*.sqlite
*.db-wal
*.db-shm
