{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{.agents/**,.claude/**,.codex/**,.pytest_cache/**,.ruff_cache/**,.venv/**,__pycache__/**,**/__pycache__/**,**/*.pyc,docs/**,examples/**,instance/**,output/**,plans/**,scripts/**,tests/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
